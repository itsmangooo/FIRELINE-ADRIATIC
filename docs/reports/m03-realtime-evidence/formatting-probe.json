  "source": "using System;\nusing System.Globalization;\n/// <summary>Independent installed-runtime diagnostic; no game assembly or state is loaded.</summary>\npublic static class Probe {\n    /// <summary>Print fixed and signed readouts for every invariant command-line double.</summary>\n    public static void Main(string[] args) {\n        foreach(string arg in args) {\n            double v=double.Parse(arg,CultureInfo.InvariantCulture);\n            Console.WriteLine(string.Join(\"|\",v.ToString(\"F2\",CultureInfo.InvariantCulture),\n                v.ToString(\"+0.00;-0.00;0.00\",CultureInfo.InvariantCulture),\n                v.ToString(\"+0.0;-0.0;0.0\",CultureInfo.InvariantCulture),\n                v.ToString(\"F3\",CultureInfo.InvariantCulture)));\n        }\n    }\n}\n",
